# Copy to .env and fill in. Never commit .env — it is gitignored.

# Your Supabase project (Project Settings → API). The anon key is safe in the browser:
# row-level security is what protects the data, not the key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the BPA sidecar runs (see ../sidecar/README.md).
VITE_SIDECAR_URL=http://127.0.0.1:8000
