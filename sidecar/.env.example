# Worker only — never commit a filled copy (gitignored).
# The worker signs in as an analyst service account: RLS applies to it exactly
# as to human analysts. No service_role key exists anywhere in this project.

# Your Supabase project (same values as app/.env, without the VITE_ prefix).
SUPABASE_URL=https://pkebstfwndhftxajztcx.supabase.co
SUPABASE_ANON_KEY=PASTE_ANON_KEY_FROM_DASHBOARD

# Analyst service account (create once in the dashboard: Auth -> Users -> Add user
# with email_confirm on, then set its profiles.full_name to Firman and its
# profiles.role to analyst). The worker IS this user.
WORKER_EMAIL=firman@hemospot.local
WORKER_PASSWORD=PASTE_WORKER_PASSWORD

# Where the API in main.py listens (same machine on demo day).
SIDECAR_URL=http://127.0.0.1:8000

# Queue tuning. STALE_MINUTES is the NFR1.4 knob: a claim older than this is dead
# and its job goes back to pending.
POLL_SECONDS=10
STALE_MINUTES=5
MAX_ATTEMPTS=5
