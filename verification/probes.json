    { "n": 62, "nfr": "1.1", "role": "admin",    "method": "PATCH", "path": "rest/v1/analyses?id=eq.$A_R2", "expect": "allow", "label": "admin approves a ready analysis", "body": { "status": "approved", "reviewed_by": "$ARMAN_ID" } },

