{
  "note": "T-016 RBAC probe matrix. Each probe is one HTTP attempt made AS a persona against the live Supabase project. 'allow' means the rows/mutation must come through; 'deny' means Postgres RLS must refuse it (403 for writes, an empty set for reads/updates). $TOKENS are replaced by rbac-matrix.ps1.",
  "shorthands": {
    "CASE_O": "00000000-0000-4000-8000-000000000001",
    "CASE_R": "00000000-0000-4000-8000-000000000002",
    "CASE_C": "00000000-0000-4000-8000-000000000003",
    "EV_O": "00000000-0000-4000-8000-000000000004",
    "EV_R": "00000000-0000-4000-8000-000000000005",
    "EV_C": "00000000-0000-4000-8000-000000000006",
      "CE_O1": "00000000-0000-4000-8000-000000000011",
      "CE_C": "00000000-0000-4000-8000-000000000013",
    "TR_0": "00000000-0000-4000-8000-000000000040",
    "TR_1": "00000000-0000-4000-8000-000000000041",
    "A_R": "00000000-0000-4000-8000-000000000021",
    "A_R2": "00000000-0000-4000-8000-000000000026",
    "A_Q": "00000000-0000-4000-8000-000000000022",
    "A_O": "00000000-0000-4000-8000-000000000023",
    "J_O": "00000000-0000-4000-8000-000000000024",
    "J_Q": "00000000-0000-4000-8000-000000000025",
    "N_1": "00000000-0000-4000-8000-000000000031",
    "N_2": "00000000-0000-4000-8000-000000000032",
    "FAKE_SHA": "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef",
    "PATTERN_NAME": "verify-pattern.png"
  },
  "probes": [
    { "n": 1,  "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_O", "expect": "deny",  "label": "viewer cannot read an open case" },
    { "n": 2,  "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_C", "expect": "allow", "label": "viewer reads a closed case" },
    { "n": 3,  "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_O", "expect": "deny",  "label": "reviewer cannot read an open case" },
    { "n": 4,  "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_R", "expect": "allow", "label": "reviewer reads a case under review" },
    { "n": 5,  "nfr": "1.1", "role": "analyst",  "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_O", "expect": "allow", "label": "analyst reads the case assigned to them" },
    { "n": 6,  "nfr": "1.1", "role": "analyst",  "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_R", "expect": "deny",  "label": "analyst cannot read a case not assigned to them" },
    { "n": 7,  "nfr": "1.1", "role": "lead",     "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_C", "expect": "allow", "label": "lead reads any case" },
    { "n": 8,  "nfr": "1.1", "role": "admin",    "method": "GET", "path": "rest/v1/cases?select=id&id=eq.$CASE_O", "expect": "allow", "label": "admin reads any case" },
    { "n": 9,  "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/cases", "expect": "deny",  "label": "analyst cannot create cases", "body": { "case_number": "VERIFY-ANALYST-PROBE", "title": "Forbidden", "status": "open", "created_by": "$FIRMAN_ID" } },
    { "n": 10, "nfr": "1.1", "role": "viewer",   "method": "POST", "path": "rest/v1/cases", "expect": "deny",  "label": "viewer cannot create cases", "body": { "case_number": "VERIFY-VIEWER-PROBE", "title": "Forbidden", "status": "open", "created_by": "$MOWMITA_ID" } },
    { "n": 11, "nfr": "1.1", "role": "lead",     "method": "POST", "path": "rest/v1/cases", "expect": "allow", "label": "lead creates a case (own byline)", "body": { "case_number": "VERIFY-LEAD-PROBE", "title": "Verification: probe-created case", "status": "open", "created_by": "$NAHIN_ID" } },
    { "n": 12, "nfr": "1.1", "role": "viewer",   "method": "PATCH", "path": "rest/v1/cases?id=eq.$CASE_C", "expect": "deny",  "label": "viewer cannot edit a case", "body": { "title": "tampered" } },
    { "n": 13, "nfr": "1.1", "role": "reviewer", "method": "PATCH", "path": "rest/v1/cases?id=eq.$CASE_R", "expect": "deny",  "label": "reviewer cannot edit a case", "body": { "title": "tampered" } },
    { "n": 14, "nfr": "1.1", "role": "analyst",  "method": "PATCH", "path": "rest/v1/cases?id=eq.$CASE_O", "expect": "deny",  "label": "analyst cannot edit even an assigned case", "body": { "title": "tampered" } },
    { "n": 15, "nfr": "1.1", "role": "lead",     "method": "PATCH", "path": "rest/v1/cases?id=eq.$CASE_O", "expect": "allow", "label": "lead edits the case they created", "body": { "title": "Verification: open case (lead probe)" } },
    { "n": 16, "nfr": "1.1", "role": "admin",    "method": "PATCH", "path": "rest/v1/cases?id=eq.$CASE_C", "expect": "allow", "label": "admin edits any case", "body": { "title": "Verification: closed case (admin probe)" } },

    { "n": 17, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/case_transitions?select=id&id=eq.$TR_1", "expect": "allow", "label": "viewer reads history of a case under review" },
    { "n": 18, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/case_transitions?select=id&id=eq.$TR_0", "expect": "deny",  "label": "viewer cannot read history of an open case" },
    { "n": 19, "nfr": "1.1", "role": "analyst",  "method": "GET", "path": "rest/v1/case_transitions?select=id&id=eq.$TR_0", "expect": "allow", "label": "analyst reads case history (staff)" },
    { "n": 20, "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/case_transitions?select=id&id=eq.$TR_0", "expect": "deny",  "label": "reviewer cannot read history of an open case" },
    { "n": 21, "nfr": "1.1", "role": "viewer",   "method": "POST", "path": "rest/v1/case_transitions", "expect": "deny",  "label": "viewer cannot record transitions", "body": { "case_id": "$CASE_O", "from_status": "open", "to_status": "open", "acted_by": "$MOWMITA_ID", "note": "forbidden" } },
    { "n": 22, "nfr": "1.1", "role": "reviewer", "method": "POST", "path": "rest/v1/case_transitions", "expect": "deny",  "label": "reviewer cannot record transitions", "body": { "case_id": "$CASE_O", "from_status": "open", "to_status": "open", "acted_by": "$MOSADDIKA_ID", "note": "forbidden" } },
    { "n": 23, "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/case_transitions", "expect": "allow", "label": "analyst records a transition as themselves", "body": { "case_id": "$CASE_O", "from_status": "open", "to_status": "open", "acted_by": "$FIRMAN_ID", "note": "Verification probe transition" } },
    { "n": 24, "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/case_transitions", "expect": "deny",  "label": "analyst cannot record a transition as someone else", "body": { "case_id": "$CASE_O", "from_status": "open", "to_status": "open", "acted_by": "$NAHIN_ID", "note": "spoofed byline" } },
    { "n": 25, "nfr": "1.1", "role": "lead",     "method": "POST", "path": "rest/v1/case_transitions", "expect": "allow", "label": "lead records a transition as themselves", "body": { "case_id": "$CASE_O", "from_status": "open", "to_status": "open", "acted_by": "$NAHIN_ID", "note": "Verification probe transition" } },

    { "n": 26, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/evidence?select=id&id=eq.$EV_O", "expect": "deny",  "label": "viewer cannot read evidence on an open case" },
    { "n": 27, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/evidence?select=id&id=eq.$EV_C", "expect": "allow", "label": "viewer reads evidence on a closed case" },
    { "n": 28, "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/evidence?select=id&id=eq.$EV_R", "expect": "allow", "label": "reviewer reads evidence on a case under review" },
    { "n": 29, "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/evidence?select=id&id=eq.$EV_O", "expect": "deny",  "label": "reviewer cannot read evidence on an open case" },
    { "n": 30, "nfr": "1.1", "role": "analyst",  "method": "GET", "path": "rest/v1/evidence?select=id&id=eq.$EV_O", "expect": "allow", "label": "analyst reads evidence (staff)" },
    { "n": 31, "nfr": "1.1", "role": "viewer",   "method": "POST", "path": "rest/v1/evidence", "expect": "deny",  "label": "viewer cannot register evidence", "body": { "case_id": "$CASE_C", "file_name": "x.png", "storage_path": "evidence/x/x.png", "mime_type": "image/png", "size_bytes": 1, "sha256_hex": "$FAKE_SHA", "item_type": "scene_photo", "uploaded_by": "$MOWMITA_ID" } },
    { "n": 32, "nfr": "1.1", "role": "reviewer", "method": "POST", "path": "rest/v1/evidence", "expect": "deny",  "label": "reviewer cannot register evidence", "body": { "case_id": "$CASE_C", "file_name": "x.png", "storage_path": "evidence/x/x.png", "mime_type": "image/png", "size_bytes": 1, "sha256_hex": "$FAKE_SHA", "item_type": "scene_photo", "uploaded_by": "$MOSADDIKA_ID" } },
    { "n": 33, "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/evidence", "expect": "allow", "label": "analyst registers evidence as themselves", "body": { "case_id": "$CASE_O", "file_name": "verify-probe.png", "storage_path": "evidence/$FIRMAN_ID/verify-probe.png", "mime_type": "image/png", "size_bytes": 1, "sha256_hex": "$FAKE_SHA", "item_type": "scene_photo", "uploaded_by": "$FIRMAN_ID" } },
    { "n": 34, "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/evidence", "expect": "deny",  "label": "analyst cannot register evidence under someone else's name", "body": { "case_id": "$CASE_O", "file_name": "x.png", "storage_path": "evidence/x/x.png", "mime_type": "image/png", "size_bytes": 1, "sha256_hex": "$FAKE_SHA", "item_type": "scene_photo", "uploaded_by": "$NAHIN_ID" } },

    { "n": 35, "nfr": "1.2", "role": "viewer",   "method": "GET", "path": "rest/v1/custody_events?select=id&id=eq.$CE_O1", "expect": "deny",  "label": "viewer cannot read custody chain of an open case" },
    { "n": 36, "nfr": "1.2", "role": "viewer",   "method": "GET", "path": "rest/v1/custody_events?select=id&evidence_id=eq.$EV_C", "expect": "allow", "label": "viewer reads custody chain of a closed case" },
    { "n": 37, "nfr": "1.2", "role": "analyst",  "method": "GET", "path": "rest/v1/custody_events?select=id&id=eq.$CE_O1", "expect": "allow", "label": "analyst reads custody chain (staff)" },
    { "n": 38, "nfr": "1.2", "role": "reviewer", "method": "GET", "path": "rest/v1/custody_events?select=id&id=eq.$CE_O1", "expect": "deny",  "label": "reviewer cannot read custody chain of an open case" },
    { "n": 39, "nfr": "1.2", "role": "viewer",   "method": "POST", "path": "rest/v1/custody_events", "expect": "deny",  "label": "viewer cannot record custody events", "body": { "evidence_id": "$EV_O", "actor": "$MOWMITA_ID", "action": "received", "reason": "forbidden" } },
    { "n": 40, "nfr": "1.2", "role": "reviewer", "method": "POST", "path": "rest/v1/custody_events", "expect": "deny",  "label": "reviewer cannot record custody events", "body": { "evidence_id": "$EV_O", "actor": "$MOSADDIKA_ID", "action": "received", "reason": "forbidden" } },
    { "n": 41, "nfr": "1.2", "role": "analyst",  "method": "POST", "path": "rest/v1/custody_events", "expect": "allow", "label": "analyst records a custody event as themselves", "body": { "evidence_id": "$EV_O", "actor": "$FIRMAN_ID", "action": "received", "reason": "Verification probe custody row" } },
    { "n": 42, "nfr": "1.2", "role": "analyst",  "method": "POST", "path": "rest/v1/custody_events", "expect": "deny",  "label": "analyst cannot record custody as someone else", "body": { "evidence_id": "$EV_O", "actor": "$NAHIN_ID", "action": "received", "reason": "spoofed byline" } },
    { "n": 43, "nfr": "1.2", "role": "analyst",  "method": "PATCH", "path": "rest/v1/custody_events?id=eq.$CE_O1", "expect": "deny",  "label": "custody rows cannot be edited (analyst)", "body": { "reason": "tampered" }, "after": { "sql": "select reason from public.custody_events where id = '$CE_O1'", "want": "Sealed into evidence locker (verification fixture)" } },
    { "n": 44, "nfr": "1.2", "role": "admin",    "method": "PATCH", "path": "rest/v1/custody_events?id=eq.$CE_O1", "expect": "deny",  "label": "custody rows cannot be edited (admin)", "body": { "action": "released" } },
    { "n": 45, "nfr": "1.2", "role": "admin",    "method": "DELETE", "path": "rest/v1/custody_events?id=eq.$CE_O1", "expect": "deny",  "label": "custody rows cannot be deleted (admin)", "after": { "sql": "select count(*)::text as n from public.custody_events where id = '$CE_O1'", "want": "1" } },

    { "n": 46, "nfr": "1.5", "role": "analyst",  "method": "PATCH", "path": "rest/v1/evidence?id=eq.$EV_O", "expect": "deny",  "label": "evidence rows cannot be edited", "body": { "item_type": "tampered" } },
    { "n": 47, "nfr": "1.5", "role": "admin",    "method": "DELETE", "path": "rest/v1/evidence?id=eq.$EV_O", "expect": "deny",  "label": "evidence rows cannot be deleted (admin)", "after": { "sql": "select count(*)::text as n from public.evidence where id = '$EV_O'", "want": "1" } },

    { "n": 48, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/analyses?select=id&id=eq.$A_O", "expect": "deny",  "label": "viewer cannot read analysis on an open case" },
    { "n": 49, "nfr": "1.1", "role": "viewer",   "method": "GET", "path": "rest/v1/analyses?select=id&id=eq.$A_R", "expect": "allow", "label": "viewer reads analysis on a case under review" },
    { "n": 50, "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/analyses?select=id&id=eq.$A_O", "expect": "deny",  "label": "reviewer cannot see an analysis that is not ready" },
    { "n": 51, "nfr": "1.1", "role": "reviewer", "method": "GET", "path": "rest/v1/analyses?select=id&id=eq.$A_R", "expect": "allow", "label": "reviewer reads an analysis ready for review" },
    { "n": 52, "nfr": "1.1", "role": "analyst",  "method": "GET", "path": "rest/v1/analyses?select=id&id=eq.$A_O", "expect": "allow", "label": "analyst reads analyses (staff)" },
    { "n": 53, "nfr": "1.1", "role": "analyst",  "method": "POST", "path": "rest/v1/analyses", "expect": "deny",  "label": "analyst cannot request analyses (lead/admin own that gate)", "body": { "evidence_id": "$EV_O", "requested_by": "$FIRMAN_ID" } },
    { "n": 54, "nfr": "1.1", "role": "viewer",   "method": "POST", "path": "rest/v1/analyses", "expect": "deny",  "label": "viewer cannot request analyses", "body": { "evidence_id": "$EV_O", "requested_by": "$MOWMITA_ID" } },
    { "n": 55, "nfr": "1.1", "role": "lead",     "method": "POST", "path": "rest/v1/analyses", "expect": "allow", "label": "lead requests an analysis", "body": { "evidence_id": "$EV_R", "requested_by": "$NAHIN_ID" } },
    { "n": 56, "nfr": "1.1", "role": "lead",     "method": "POST", "path": "rest/v1/analyses", "expect": "deny",  "label": "lead cannot request under someone else's name", "body": { "evidence_id": "$EV_O", "requested_by": "$FIRMAN_ID" } },
    { "n": 57, "nfr": "1.1", "role": "analyst",  "method": "PATCH", "path": "rest/v1/analyses?id=eq.$A_Q", "expect": "allow", "label": "analyst finishes their analysis", "body": { "status": "ready_for_review" } },
